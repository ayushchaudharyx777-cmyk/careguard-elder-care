DATABASE_URL=sqlite:///./careguard.db
CRON_SECRET=replace-with-a-random-32-char-secret
SESSION_HOURS=12
ENABLE_SCHEDULER=true
REMINDER_INTERVAL_SECONDS=60
UPCOMING_WINDOW_MINUTES=15
MISSED_AFTER_MINUTES=60
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=secret-app-password
SMTP_FROM=CareGuard <notifications@example.com>
SMTP_STARTTLS=true

